# Обязательный секретный ключ для подписи токенов авторизации (минимум 32 символа)
AUTH_SECRET_KEY=

# Режим строгого HTTPS в продакшене (1 = включён, 0 = выключен для локальной разработки)
PRINT_CALC_FORCE_HTTPS=0

# Количество доверенных reverse-proxy перед Flask (например, 1 для Nginx / Caddy / Cloud Run)
PRINT_CALC_TRUST_PROXY_HOPS=0

# Срок действия заголовка Strict-Transport-Security (в секундах, по умолчанию 1 год)
PRINT_CALC_HSTS_MAX_AGE=31536000

# Разрешённые источники CORS (в режиме PRINT_CALC_FORCE_HTTPS=1 внешние домены обязаны использовать https://)
PRINT_CALC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Хранилище данных: json (по умолчанию) или mongo
DATA_BACKEND=json
PRINT_CALC_DATA_DIR=
MONGODB_URI=
MONGODB_DATABASE=print_calculator

# Опционально: ключи Google reCAPTCHA v2 для форм входа и регистрации
RECAPTCHA_SECRET_KEY=
RECAPTCHA_REQUIRED=0
VITE_RECAPTCHA_SITE_KEY=

# Автосоздание стартовых аккаунтов для локальной разработки (в продакшене оставляйте 0)
PRINT_CALC_SEED_DEFAULT_USERS=0
PRINT_CALC_SEED_ADMIN_EMAIL=
PRINT_CALC_SEED_ADMIN_PASSWORD=
PRINT_CALC_SEED_MANAGER_EMAIL=
PRINT_CALC_SEED_MANAGER_PASSWORD=
PRINT_CALC_SEED_PRODUCTION_EMAIL=
PRINT_CALC_SEED_PRODUCTION_PASSWORD=
